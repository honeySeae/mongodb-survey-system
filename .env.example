# 复制为 .env 后按需修改

# MongoDB 连接串（本地开发为 localhost:27017；部署时改成服务器上的地址）
MONGO_URI=mongodb://localhost:27017
# 开发/演示使用的数据库名（测试会自动改用 survey_test，不影响这里的数据）
MONGO_DB_NAME=survey_dev

# JWT 签名密钥：请改成一段足够长的随机字符串
JWT_SECRET=change-me-to-a-long-random-string
# 登录令牌有效期（分钟）
JWT_EXPIRE_MINUTES=1440

# 对外访问地址（协议 + 域名/IP + 端口，结尾不要加 /），用于生成问卷链接 <地址>/survey/<shortCode>
# 本地开发：http://localhost:8000；部署到服务器时改成服务器的公网地址或域名
PUBLIC_BASE_URL=http://localhost:8000
